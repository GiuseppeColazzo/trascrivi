# Ambiente Python
.venv/
__pycache__/
*.py[cod]

# Materiale delle lezioni (grande, non versionare)
lezioni/
trascrizioni/
testdata/

# Stato e dati della piattaforma (DB, copie audio, chiavi API, trascrizioni)
data/

# Segreti e cache locali
.env
.uvcache/
.pytest_cache/

# Cache
.pipcache/
.piptmp/
# Cartelle temporanee dei tool di sviluppo: Playwright non può scrivere nella
# cartella di sistema in alcuni ambienti, quindi browser e file temporanei
# stanno qui (vedi tools/shots.py). Sono centinaia di MB.
.tmp/
.pwbrowsers/
# Screenshot di review: si rigenerano con `tools/shots.py`.
tools/shots/out/
# Pytest può creare le sue cartelle dentro il repo quando TMPDIR non è scrivibile.
pytest-of-*/
# Modelli Whisper/HF scaricati quando la cache di sistema non è scrivibile
# (vedi `hf_cache_dir` in trascrivi_audio.py): pesano GB, non si versionano.
models/

# Documentazione prodotta dalle ricerche web: materiale di lavoro, non parte del
# progetto. Convenzione: <argomento>-<AAAA-MM-GG>.md nella radice; i README non
# hanno date nel nome, quindi non finiscono qui.
/*-20[0-9][0-9]-[0-9][0-9]*.md

# Artefatti del collaudo frontend (.smoke/smoke.mjs)
.smoke/__app_under_test.mjs
.smoke/bench_summary_results.json

