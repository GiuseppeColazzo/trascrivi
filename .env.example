# Copy to .env and adjust. Values already set in the environment are not overridden.
# Fernet key used to encrypt the LLM API keys stored in data/secret.key.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you set this, keep it somewhere safe: without it the stored API keys cannot be decrypted.
TRASCRIVI_SECRET=
# Optional: disable the Hugging Face "xet" download backend if model downloads fail on Windows.
# HF_HUB_DISABLE_XET=1
# Optional: where model downloads are cached. Leave it unset to use
# %USERPROFILE%\.cache\huggingface, with an automatic fallback to <project>\models\hf
# when that folder is not writable (AV, roaming profile, sandboxed process).
# Setting it here wins over the fallback and applies to the server and the CLI.
# HF_HOME=C:\path\to\models\hf
